# Zoho Mail SMTP
# Host: smtp.zoho.com (US), smtp.zoho.eu (EU), smtp.zoho.in (India), or smtppro.zoho.com
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# From must be a Zoho mailbox you can send as. Defaults to ZOHO_SMTP_USER if empty.
ZOHO_MAIL_FROM=

# Where contact form messages should arrive. Defaults to ZOHO_SMTP_USER if empty.
CONTACT_MAIL_TO=

# YouTube Data API v3 (Watch Live page)
# Enable the API, then create a key: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Optional. Channel ID starts with UC. If empty, we look up @icgclwt.
YOUTUBE_CHANNEL_ID=

# Optional. Handle without @. Defaults to icgclwt.
YOUTUBE_CHANNEL_HANDLE=

# Optional. Sermons playlist ID starts with PL. If empty, we use recent channel uploads.
YOUTUBE_PLAYLIST_ID=
